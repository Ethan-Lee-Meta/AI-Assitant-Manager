import { apiGet, apiFetch, apiPost } from "./client";

export type Series = {
  id: string;
  project_id: string;
  name: string;
  style_text?: string | null;
  continuity_text?: string | null;
  prompt_ids?: string[];
  role_ids?: string[];
  created_at?: string;
  updated_at?: string | null;
  archived_at?: string | null;
};

export type SeriesListResp = {
  total: number;
  items: Series[];
  limit: number;
  offset: number;
};

export async function listSeries(args: {
  project_id: string;
  q?: string;
  limit?: number;
  offset?: number;
}): Promise<SeriesListResp> {
  const qs = new URLSearchParams();
  qs.set("project_id", args.project_id);
  if (args.q) qs.set("q", args.q);
  qs.set("limit", String(args.limit ?? 50));
  qs.set("offset", String(args.offset ?? 0));
  return apiGet(`/api/series?${qs.toString()}`);
}

export async function createSeries(body: {
  project_id: string;
  name: string;
  style_text?: string | null;
  continuity_text?: string | null;
  prompt_ids?: string[];
  role_ids?: string[];
}): Promise<Series> {
  return apiPost(`/api/series`, body);
}

export async function getSeries(series_id: string): Promise<Series> {
  return apiGet(`/api/series/${series_id}`);
}

export async function updateSeries(
  series_id: string,
  patch: Partial<Pick<Series, "name" | "style_text" | "continuity_text" | "prompt_ids" | "role_ids" | "archived_at">>
): Promise<Series> {
  return apiFetch(`/api/series/${series_id}`, {
    method: "PATCH",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(patch ?? {}),
  });
}
