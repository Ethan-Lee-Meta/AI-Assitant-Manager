import { apiGet, apiPost } from "./client";

export type Provider = {
  id: string;
  name: string;
  provider_type: string;
  supported_kinds: string[];
  endpoint_config?: Record<string, unknown> | null;
  is_enabled: boolean;
  archived: boolean;
  created_at: string;
  updated_at: string;
};

export type ProviderCreate = {
  name: string;
  provider_type: string;
  supported_kinds: string[];
  endpoint_config?: Record<string, unknown> | null;
  is_enabled?: boolean;
};

export type ListResponse<T> = { total: number; items: T[] };

export async function listProviders(params?: {
  q?: string;
  archived?: boolean;
  limit?: number;
  offset?: number;
  sort?: string;
}): Promise<ListResponse<Provider>> {
  const sp = new URLSearchParams();
  if (params?.q) sp.set("q", params.q);
  if (typeof params?.archived === "boolean") sp.set("archived", String(params.archived));
  if (typeof params?.limit === "number") sp.set("limit", String(params.limit));
  if (typeof params?.offset === "number") sp.set("offset", String(params.offset));
  if (params?.sort) sp.set("sort", params.sort);

  const qs = sp.toString();
  return apiGet<ListResponse<Provider>>(`/api/providers${qs ? `?${qs}` : ""}`);
}

export async function createProvider(body: ProviderCreate): Promise<Provider> {
  return apiPost<Provider>("/api/providers", body);
}
