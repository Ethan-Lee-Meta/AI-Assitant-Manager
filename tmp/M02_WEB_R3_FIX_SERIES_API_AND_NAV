"use client";

import { useEffect, useState } from "react";
import { Series, getSeries } from "../../lib/api/series";

export function SeriesDetail({ seriesId }: { seriesId: string }) {
  const [item, setItem] = useState<Series | null>(null);
  const [err, setErr] = useState<string | null>(null);

  useEffect(() => {
    let ok = true;
    (async () => {
      try {
        const r = await getSeries(seriesId);
        if (!ok) return;
        setItem(r);
      } catch (e: any) {
        if (!ok) return;
        setErr(e?.message || "failed to load");
      }
    })();
    return () => { ok = false; };
  }, [seriesId]);

  if (err) {
    return (
      <div style={{ padding: 12, background: "#fee", border: "1px solid #f99", borderRadius: 8 }}>
        <div style={{ fontWeight: 700, marginBottom: 6 }}>Series Error</div>
        <pre style={{ margin: 0, whiteSpace: "pre-wrap" }}>{err}</pre>
      </div>
    );
  }

  if (!item) return <div style={{ color: "#666" }}>Loading...</div>;

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
      <div style={{ fontSize: 20, fontWeight: 800 }}>{item.name}</div>
      <div style={{ fontFamily: "monospace" }}>id: {item.id}</div>
      <div>project_id: {item.project_id}</div>
      <div>archived_at: {item.archived_at || "(null)"}</div>
      <div style={{ marginTop: 10 }}>
        <div style={{ fontWeight: 700, marginBottom: 6 }}>style_text</div>
        <pre style={{ padding: 10, background: "#f7f7f7", borderRadius: 8, whiteSpace: "pre-wrap" }}>{item.style_text || ""}</pre>
      </div>
      <div>
        <div style={{ fontWeight: 700, marginBottom: 6 }}>continuity_text</div>
        <pre style={{ padding: 10, background: "#f7f7f7", borderRadius: 8, whiteSpace: "pre-wrap" }}>{item.continuity_text || ""}</pre>
      </div>
    </div>
  );
}
