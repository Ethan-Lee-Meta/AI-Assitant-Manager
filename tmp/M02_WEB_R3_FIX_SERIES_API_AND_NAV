python - <<'PY'
from pathlib import Path
import re, sys

p = Path(sys.argv[1])
t = p.read_text(encoding="utf-8", errors="ignore")

if "/series" in t:
    print("[ok] nav already contains /series; skip")
    raise SystemExit(0)

# Case 1: JSX links: <Link href="/projects">Projects</Link> or <a href="/projects">
m = re.search(r'(^.*?(Link|a)\s+[^>\n]*href\s*=\s*["\']\/projects["\'][^\n]*\n?)', t, re.M)
if m:
    line = m.group(1)
    # try to clone line and adjust label if it's literal Projects
    series_line = line.replace('/projects', '/series')
    series_line = series_line.replace('Projects', 'Series').replace('projects', 'series')
    # insert immediately after the projects line
    t2 = t[:m.end(1)] + series_line + t[m.end(1):]
    p.write_text(t2, encoding="utf-8")
    print(f"[ok] inserted /series nav after JSX /projects in {p}")
    raise SystemExit(0)

# Case 2: object-based config: href: "/projects"
m = re.search(r'(href\s*:\s*["\']\/projects["\']\s*,.*?\n)', t)
if m:
    # naive insertion: add a sibling object entry near projects entry if we can detect object literal block
    # We insert a minimal block that should typecheck if only label+href are required; if more keys exist, this may fail (and that's OK: we will stop further changes).
    insert = '  { label: "Series", href: "/series" },\n'
    t2 = t[:m.end(1)] + insert + t[m.end(1):]
    p.write_text(t2, encoding="utf-8")
    print(f"[ok] inserted minimal object nav item for /series in {p}")
    raise SystemExit(0)

print(f"[fatal] cannot safely patch nav file {p}: unrecognized structure (no JSX href=\"/projects\" and no href: \"/projects\")")
raise SystemExit(2)
