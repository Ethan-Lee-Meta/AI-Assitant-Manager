#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

echo "[info] M02_WEB_R3 starting..."
echo "[info] repo_root=$repo_root"

# ----------------------------
# A) Fix web api base fallback (avoid calling :2000 /api/*)
# ----------------------------
echo "[step] locate apiFetch/getApiBaseUrl implementation..."

api_base_file=""
# prefer: file that mentions NEXT_PUBLIC_API_BASE_URL or getApiBaseUrl or apiFetch
for cand in \
  $(rg -n "NEXT_PUBLIC_API_BASE_URL|getApiBaseUrl|export async function apiFetch|function apiFetch" apps/web/src -S --files-with-matches || true)
do
  api_base_file="$cand"
  break
done

if [[ -z "${api_base_file}" ]]; then
  echo "[fatal] cannot locate api base implementation in apps/web/src (no matches for NEXT_PUBLIC_API_BASE_URL|getApiBaseUrl|apiFetch)"
  exit 1
fi

echo "[info] api base file candidate: $api_base_file"
cp -a "$api_base_file" "$api_base_file.bak.$(date +%Y%m%d_%H%M%S)"
echo "[ok] backup: $api_base_file.bak.*"

python - <<'PY'
from pathlib import Path
import re, sys, datetime

p = Path(sys.argv[1])
t = p.read_text(encoding="utf-8", errors="ignore")

# If there's an existing getApiBaseUrl, patch it to have fallback localhost:7000.
if "function getApiBaseUrl" in t or "export function getApiBaseUrl" in t:
    # Replace entire function body conservatively.
    pat = re.compile(r"(export\s+)?function\s+getApiBaseUrl\s*\(\s*\)\s*:\s*string\s*\{.*?\n\}", re.S)
    if not pat.search(t):
        pat = re.compile(r"(export\s+)?function\s+getApiBaseUrl\s*\(\s*\)\s*\{.*?\n\}", re.S)

    repl = """export function getApiBaseUrl(): string {
  const v = (process.env.NEXT_PUBLIC_API_BASE_URL || "").trim();
  // Hard fallback for local dev to avoid hitting Next(:2000) /api/* and receiving HTML
  const base = v || "http://localhost:7000";
  return base.replace(/\\/+$/, "");
}"""
    if pat.search(t):
        t2 = pat.sub(repl, t, count=1)
    else:
        # If signature not found, append a safe helper and do not risk breaking existing code.
        t2 = t + "\n\n" + repl + "\n"
    p.write_text(t2, encoding="utf-8")
    print(f"[ok] patched getApiBaseUrl fallback in {p}")
    sys.exit(0)

# Otherwise, try to patch common pattern inside apiFetch where base is derived.
# We do NOT try to rewrite unknown architectures; we only add a fallback if a base variable is present.
if "NEXT_PUBLIC_API_BASE_URL" in t and "http://localhost:7000" not in t:
    t2 = t.replace('process.env.NEXT_PUBLIC_API_BASE_URL', '(process.env.NEXT_PUBLIC_API_BASE_URL || "http://localhost:7000")')
    p.write_text(t2, encoding="utf-8")
    print(f"[ok] injected fallback into NEXT_PUBLIC_API_BASE_URL usage in {p}")
    sys.exit(0)

# If neither recognizable, fail loudly (no guessing).
print(f"[fatal] cannot safely patch api base logic in {p}: no getApiBaseUrl() and no recognizable NEXT_PUBLIC_API_BASE_URL usage")
sys.exit(2)
PY "$api_base_file"

# ----------------------------
# B) Ensure series API wrapper exists (client-side fetch only)
#    (Uses same apiFetch import path as other wrappers if present)
# ----------------------------
echo "[step] write series api wrapper..."

api_sample=""
for s in apps/web/src/lib/api/prompts.ts apps/web/src/lib/api/projects.ts apps/web/src/lib/api/providers.ts; do
  if [[ -f "$s" ]]; then api_sample="$s"; break; fi
done
if [[ -z "$api_sample" ]]; then
  echo "[fatal] cannot find sample api wrapper in apps/web/src/lib/api (prompts.ts/projects.ts/providers.ts missing)"
  exit 1
fi

api_import_line="$(python - <<'PY'
import re, sys
from pathlib import Path
t = Path(sys.argv[1]).read_text(encoding="utf-8", errors="ignore").splitlines()
for ln in t:
    if "apiFetch" in ln and "from" in ln and "import" in ln:
        print(ln.strip())
        raise SystemExit(0)
print("")
PY "$api_sample")"

if [[ -z "$api_import_line" ]]; then
  echo "[fatal] cannot infer apiFetch import from sample: $api_sample"
  echo "[hint] please rg -n \"apiFetch\" $api_sample and paste the import line"
  exit 1
fi

mkdir -p "apps/web/src/lib/api"

cat > "apps/web/src/lib/api/series.ts" <<EOF
${api_import_line}

export type Series = {
  id: string;
  project_id: string;
  name: string;
  style_text?: string | null;
  continuity_text?: string | null;
  archived_at?: string | null;
  created_at?: string;
  updated_at?: string;
};

export type SeriesCreate = {
  project_id: string;
  name: string;
  style_text?: string | null;
  continuity_text?: string | null;
};

export type SeriesPatch = Partial<{
  name: string;
  style_text: string | null;
  continuity_text: string | null;
  archived_at: string | null;
}>;

export type ListResp<T> = {
  items: T[];
  total: number;
  limit: number;
  offset: number;
};

export async function listSeries(params: { project_id: string; q?: string; archived?: boolean; limit?: number; offset?: number; sort?: string; }) {
  const qs = new URLSearchParams();
  qs.set("project_id", params.project_id);
  if (params.q) qs.set("q", params.q);
  if (typeof params.archived === "boolean") qs.set("archived", String(params.archived));
  if (typeof params.limit === "number") qs.set("limit", String(params.limit));
  if (typeof params.offset === "number") qs.set("offset", String(params.offset));
  if (params.sort) qs.set("sort", params.sort);

  return apiFetch<ListResp<Series>>(\`/api/series?\${qs.toString()}\`);
}

export async function createSeries(body: SeriesCreate) {
  return apiFetch<Series>("/api/series", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
}

export async function getSeries(series_id: string) {
  return apiFetch<Series>(\`/api/series/\${series_id}\`);
}

export async function updateSeries(series_id: string, patch: SeriesPatch) {
  return apiFetch<Series>(\`/api/series/\${series_id}\`, {
    method: "PATCH",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(patch ?? {}),
  });
}
EOF

