"use client";

import { useEffect, useMemo, useState } from "react";
import { Series, createSeries, listSeries, updateSeries } from "../../lib/api/series";

function nowIsoZ(): string {
  return new Date().toISOString();
}

export function SeriesList() {
  const [projectId, setProjectId] = useState<string>("p_demo");
  const [items, setItems] = useState<Series[]>([]);
  const [total, setTotal] = useState<number>(0);
  const [loading, setLoading] = useState<boolean>(false);
  const [err, setErr] = useState<string | null>(null);

  const [name, setName] = useState<string>("");
  const [styleText, setStyleText] = useState<string>("");
  const [contText, setContText] = useState<string>("");

  const canCreate = useMemo(() => (projectId || "").trim().length > 0 && (name || "").trim().length > 0, [projectId, name]);

  async function refresh() {
    setLoading(true);
    setErr(null);
    try {
      const r = await listSeries({ project_id: projectId.trim(), limit: 50, offset: 0 });
      setItems(r.items || []);
      setTotal(r.total || 0);
    } catch (e: any) {
      setErr(e?.message || "failed to load series");
      setItems([]);
      setTotal(0);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    // do not auto-load if projectId empty
    if ((projectId || "").trim()) refresh();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  async function onCreate() {
    if (!canCreate) return;
    setLoading(true);
    setErr(null);
    try {
      await createSeries({
        project_id: projectId.trim(),
        name: name.trim(),
        style_text: styleText.trim() || undefined,
        continuity_text: contText.trim() || undefined,
      });
      setName(""); setStyleText(""); setContText("");
      await refresh();
    } catch (e: any) {
      setErr(e?.message || "create failed");
    } finally {
      setLoading(false);
    }
  }

  async function toggleArchive(s: Series) {
    setLoading(true);
    setErr(null);
    try {
      const next = s.archived_at ? null : nowIsoZ();
      await updateSeries(s.id, { archived_at: next });
      await refresh();
    } catch (e: any) {
      setErr(e?.message || "update failed");
    } finally {
      setLoading(false);
    }
  }

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 14 }}>
      <div style={{ display: "flex", gap: 10, alignItems: "center" }}>
        <label style={{ fontWeight: 600 }}>project_id</label>
        <input value={projectId} onChange={(e) => setProjectId(e.target.value)} style={{ padding: 8, width: 240 }} />
        <button onClick={refresh} disabled={loading || !(projectId || "").trim()} style={{ padding: "8px 12px" }}>
          Refresh
        </button>
        {loading ? <span style={{ color: "#666" }}>Loading...</span> : null}
      </div>

      {err ? (
        <div style={{ padding: 12, background: "#fee", border: "1px solid #f99", borderRadius: 8 }}>
          <div style={{ fontWeight: 700, marginBottom: 6 }}>Series Error</div>
          <pre style={{ margin: 0, whiteSpace: "pre-wrap" }}>{err}</pre>
        </div>
      ) : null}

      <div style={{ padding: 12, border: "1px solid #ddd", borderRadius: 10 }}>
        <div style={{ fontWeight: 700, marginBottom: 10 }}>Create Series</div>
        <div style={{ display: "grid", gridTemplateColumns: "140px 1fr", gap: 10, alignItems: "center" }}>
          <div style={{ color: "#333" }}>name *</div>
          <input value={name} onChange={(e) => setName(e.target.value)} style={{ padding: 8 }} />

          <div style={{ color: "#333" }}>style_text</div>
          <textarea value={styleText} onChange={(e) => setStyleText(e.target.value)} style={{ padding: 8, minHeight: 70 }} />

          <div style={{ color: "#333" }}>continuity_text</div>
          <textarea value={contText} onChange={(e) => setContText(e.target.value)} style={{ padding: 8, minHeight: 70 }} />
        </div>

        <div style={{ marginTop: 10 }}>
          <button onClick={onCreate} disabled={loading || !canCreate} style={{ padding: "8px 12px" }}>
            Create
          </button>
          {!canCreate ? <span style={{ marginLeft: 10, color: "#777" }}>require project_id and name</span> : null}
        </div>
      </div>

      <div style={{ padding: 12, border: "1px solid #ddd", borderRadius: 10 }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline" }}>
          <div style={{ fontWeight: 700 }}>Series List</div>
          <div style={{ color: "#666" }}>total: {total}</div>
        </div>

        <div style={{ marginTop: 10, display: "flex", flexDirection: "column", gap: 8 }}>
          {items.map((s) => (
            <div key={s.id} style={{ display: "flex", gap: 10, alignItems: "center", borderBottom: "1px solid #eee", paddingBottom: 8 }}>
              <a href={`/series/${s.id}`} style={{ fontFamily: "monospace" }}>{s.id}</a>
              <div style={{ fontWeight: 700 }}>{s.name}</div>
              <div style={{ color: "#666" }}>project: {s.project_id}</div>
              <div style={{ marginLeft: "auto", display: "flex", gap: 10, alignItems: "center" }}>
                <span style={{ color: s.archived_at ? "#b00" : "#090" }}>
                  {s.archived_at ? "archived" : "active"}
                </span>
                <button onClick={() => toggleArchive(s)} disabled={loading} style={{ padding: "6px 10px" }}>
                  {s.archived_at ? "Restore" : "Archive"}
                </button>
              </div>
            </div>
          ))}
          {items.length === 0 ? <div style={{ color: "#777" }}>No items.</div> : null}
        </div>
      </div>
    </div>
  );
}
EOF

