import { apiFetch } from "./client";

export type Provider = {
  id: string;
  name: string;
  provider_type: string;
  supported_kinds: string[];
  endpoint_config?: Record<string, any> | null;
  is_enabled: boolean;
  archived_at?: string | null;
  created_at?: string;
  updated_at?: string;
};

export type ListResponse<T> = {
  items: T[];
  total: number;
  limit: number;
  offset: number;
};

export async function listProviders(params?: {
  q?: string;
  archived?: boolean;
  limit?: number;
  offset?: number;
  sort?: string;
}): Promise<ListResponse<Provider>> {
  const q = params?.q ? `&q=${encodeURIComponent(params.q)}` : "";
  const archived = typeof params?.archived === "boolean" ? `&archived=${params.archived ? "true" : "false"}` : "";
  const limit = `&limit=${params?.limit ?? 50}`;
  const offset = `&offset=${params?.offset ?? 0}`;
  const sort = `&sort=${encodeURIComponent(params?.sort ?? "created_at:desc")}`;
  return apiFetch<ListResponse<Provider>>(`/api/providers?${q}${archived}${limit}${offset}${sort}`.replace("?&", "?"));
}

export async function createProvider(body: {
  name: string;
  provider_type: string;
  supported_kinds: string[];
  endpoint_config?: Record<string, any> | null;
  is_enabled?: boolean;
}): Promise<Provider> {
  return apiFetch<Provider>("/api/providers", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
}

export async function updateProvider(id: string, patch: Partial<Provider>): Promise<Provider> {
  return apiFetch<Provider>(`/api/providers/${encodeURIComponent(id)}`, {
    method: "PATCH",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(patch),
  });
}
