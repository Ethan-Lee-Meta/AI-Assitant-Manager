            onClick={() => setTab(t.key)}
          >
            {t.label}
          </button>
        ))}
      </div>

      {tab === "providers" ? <ProvidersPanel /> : null}
      {tab === "workflows" ? <WorkflowsPanel /> : null}
      {tab === "tools" ? <ToolsPanel /> : null}
    </div>
  );
}
