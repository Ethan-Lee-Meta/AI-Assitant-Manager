"use client";

import Link from "next/link";
import { useCallback, useEffect, useMemo, useState } from "react";
import { getSeries, Series, updateSeries } from "../../lib/api/series";

function FieldRow(props: { label: string; children: any }) {
  return (
    <div style={{ display: "grid", gridTemplateColumns: "180px 1fr", gap: 10, alignItems: "start", marginBottom: 12 }}>
      <div style={{ fontSize: 13, color: "#333", paddingTop: 6 }}>{props.label}</div>
      <div>{props.children}</div>
    </div>
  );
}

export function SeriesDetail({ series_id }: { series_id: string }) {
  const [item, setItem] = useState<Series | null>(null);
  const [loading, setLoading] = useState<boolean>(false);
  const [err, setErr] = useState<string | null>(null);

  const [styleText, setStyleText] = useState<string>("");
  const [continuityText, setContinuityText] = useState<string>("");

  const canSave = useMemo(() => !!item && !loading, [item, loading]);

  const load = useCallback(async () => {
    setErr(null);
    setLoading(true);
    try {
      const r = await getSeries(series_id);
      setItem(r);
      setStyleText(r.style_text ?? "");
      setContinuityText(r.continuity_text ?? "");
    } catch (e: any) {
      setErr(e?.message || "failed to load");
    } finally {
      setLoading(false);
    }
  }, [series_id]);

  useEffect(() => { load(); }, [load]);

  const save = useCallback(async () => {
    if (!item) return;
    setErr(null);
    setLoading(true);
    try {
      const r = await updateSeries(series_id, {
        style_text: styleText.trim() ? styleText : null,
        continuity_text: continuityText.trim() ? continuityText : null,
      });
      setItem(r);
    } catch (e: any) {
      setErr(e?.message || "save failed");
    } finally {
      setLoading(false);
    }
  }, [item, series_id, styleText, continuityText]);

  const toggleArchive = useCallback(async () => {
    if (!item) return;
    setErr(null);
    setLoading(true);
    try {
      const next = item.archived_at ? null : new Date().toISOString();
      const r = await updateSeries(series_id, { archived_at: next });
      setItem(r);
    } catch (e: any) {
      setErr(e?.message || "archive toggle failed");
    } finally {
      setLoading(false);
    }
  }, [item, series_id]);

  return (
    <div style={{ padding: 24 }}>
      <div style={{ display: "flex", justifyContent: "space-between", gap: 12, alignItems: "center", marginBottom: 12 }}>
        <div>
          <div style={{ fontSize: 28, fontWeight: 900, marginBottom: 4 }}>Series Detail</div>
          <div style={{ color: "#666", fontSize: 12 }}>id: {series_id}</div>
        </div>
        <div style={{ display: "flex", gap: 10 }}>
          <Link href="/series" style={{ padding: "8px 12px", borderRadius: 10, border: "1px solid #ddd", textDecoration: "none" }}>
            Back
          </Link>
          <button disabled={!item || loading} onClick={load} style={{ padding: "8px 12px", borderRadius: 10, border: "1px solid #ddd" }}>
            Reload
          </button>
        </div>
      </div>

      {loading ? <div style={{ color: "#666", marginBottom: 10 }}>Loading...</div> : null}
      {err ? <div style={{ color: "#b00020", whiteSpace: "pre-wrap", marginBottom: 10 }}>{err}</div> : null}

      {item ? (
        <div style={{ border: "1px solid #e6e6e6", borderRadius: 12, padding: 16, background: "#fff" }}>
          <FieldRow label="project_id">{item.project_id}</FieldRow>
          <FieldRow label="name">{item.name}</FieldRow>
          <FieldRow label="archived_at">{String(item.archived_at ?? "null")}</FieldRow>

          <FieldRow label="style_text">
            <textarea value={styleText} onChange={(e) => setStyleText(e.target.value)} style={{ width: "100%", padding: 8, height: 140 }} />
          </FieldRow>

          <FieldRow label="continuity_text">
            <textarea value={continuityText} onChange={(e) => setContinuityText(e.target.value)} style={{ width: "100%", padding: 8, height: 140 }} />
          </FieldRow>

          <div style={{ display: "flex", gap: 10 }}>
            <button disabled={!canSave} onClick={save} style={{ padding: "8px 14px", borderRadius: 10, border: "1px solid #ddd" }}>
              Save
            </button>
            <button disabled={!item || loading} onClick={toggleArchive} style={{ padding: "8px 14px", borderRadius: 10, border: "1px solid #ddd" }}>
              {item.archived_at ? "Unarchive" : "Archive"}
            </button>
          </div>
        </div>
      ) : null}
    </div>
  );
}
