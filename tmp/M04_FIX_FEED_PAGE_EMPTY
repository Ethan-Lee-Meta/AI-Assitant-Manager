#!/usr/bin/env bash
set -euo pipefail

ts="$(date +%Y%m%d_%H%M%S)"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

echo "==[E0] env =="
echo "[info] repo_root=$repo_root"
PY="$(python -c 'import sys; print(sys.executable)')"
echo "[info] python=$PY"
# hard guard: must be venv python
if [[ "$PY" != *".venv"* && "$PY" != *"\\\.venv"* && "$PY" != *"/.venv/"* ]]; then
  echo "[err] current python is NOT .venv python. Please activate venv first, then re-run."
  echo "      (Git Bash) source .venv/Scripts/activate"
  exit 2
fi
echo "[rc] py_exec=0"
echo

backup_file () {
  local f="$1"
  if [[ -f "$f" ]]; then
    cp -f "$f" "$f.bak.$ts"
    echo "[ok] backup -> $f.bak.$ts"
  fi
}

write_file () {
  local f="$1"
  local tmp="$f.__tmp__.$ts"
  cat > "$tmp"
  mkdir -p "$(dirname "$f")"
  mv -f "$tmp" "$f"
  echo "[ok] wrote: $f"
}

echo "==[W1] overwrite web api: apps/web/src/lib/api/feed.ts =="
backup_file "apps/web/src/lib/api/feed.ts"
write_file "apps/web/src/lib/api/feed.ts" <<'TS'
import { apiFetch } from "./client";

export type FeedKind = "episode" | "video";

export type FeedItem = {
  id: string;
  kind: FeedKind;
  project_id: string;
  series_id: string;
  title: string;
  synopsis_text?: string | null;
  order_index?: number | null;
  assembly_preset_id?: string | null;
  created_at: string;
  updated_at?: string | null;
  archived_at?: string | null;
};

export type FeedListResp = {
  total: number;
  items: FeedItem[];
  limit: number;
  offset: number;
};

export async function listFeed(args: {
  project_id?: string;
  series_id?: string;
  kind?: FeedKind;
  q?: string;
  archived?: boolean;
  sort?: string;
  limit?: number;
  offset?: number;
} = {}): Promise<FeedListResp> {
  const params = new URLSearchParams();

  const pid = (args.project_id ?? "").trim();
  const sid = (args.series_id ?? "").trim();
  const q = (args.q ?? "").trim();

  params.set("limit", String(args.limit ?? 50));
  params.set("offset", String(args.offset ?? 0));
  params.set("archived", (args.archived ?? false) ? "true" : "false");
  params.set("sort", String(args.sort ?? "-created_at"));

  if (pid) params.set("project_id", pid);
  if (sid) params.set("series_id", sid);
  if (typeof args.kind !== "undefined") params.set("kind", String(args.kind));
  if (q) params.set("q", q);

  const qs = params.toString();
  return apiFetch<FeedListResp>(`/api/feed?${qs}`);
}
TS
echo "[rc] write_feed_ts=0"
echo

echo "==[W2] overwrite web ui: apps/web/src/ui/feed/FeedList.tsx =="
backup_file "apps/web/src/ui/feed/FeedList.tsx"
write_file "apps/web/src/ui/feed/FeedList.tsx" <<'TSX'
"use client";

import { useEffect, useMemo, useState } from "react";
import { FeedItem, FeedKind, listFeed } from "../../lib/api/feed";

type KindSel = "all" | FeedKind;

const SORT_OPTS: Array<{ label: string; value: string }> = [
  { label: "-created_at (newest first)", value: "-created_at" },
  { label: "created_at (oldest first)", value: "created_at" },
  { label: "title (A→Z)", value: "title" },
  { label: "-title (Z→A)", value: "-title" },
];

export function FeedList() {
  const [projectId, setProjectId] = useState<string>("");
  const [seriesId, setSeriesId] = useState<string>("");
  const [q, setQ] = useState<string>("");

  const [kind, setKind] = useState<KindSel>("all");
  const [archived, setArchived] = useState<boolean>(false);
  const [sort, setSort] = useState<string>("-created_at");
  const [limit, setLimit] = useState<number>(50);
  const [offset, setOffset] = useState<number>(0);

  const [items, setItems] = useState<FeedItem[]>([]);
  const [total, setTotal] = useState<number>(0);

  const [loading, setLoading] = useState<boolean>(false);
  const [err, setErr] = useState<string | null>(null);

  const canPrev = offset > 0;
  const canNext = offset + limit < total;

  const kindForApi = useMemo<FeedKind | undefined>(() => {
    return kind === "all" ? undefined : kind;
  }, [kind]);

  async function refresh(nextOffset?: number) {
    const off = typeof nextOffset === "number" ? nextOffset : offset;
    setLoading(true);
    setErr(null);
    try {
      const resp = await listFeed({
        project_id: projectId,
        series_id: seriesId,
        kind: kindForApi,
        q,
        archived,
        sort,
        limit,
        offset: off,
      });
      setItems(resp.items || []);
      setTotal(resp.total || 0);
      setOffset(resp.offset || off);
    } catch (e: any) {
      setItems([]);
      setTotal(0);
      setErr(e?.message || "failed to load feed");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    // initial load
    refresh(0);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  return (
    <div style={{ display: "grid", gap: 16 }}>
      <div style={{ padding: 12, border: "1px solid #ddd", borderRadius: 12 }}>
        <h1 style={{ margin: "0 0 6px 0" }}>Feed</h1>
        <div style={{ color: "#666", fontSize: 12 }}>
          Read-only aggregate of Episodes/Videos. Click through to Series or item workspace.
        </div>

        {err ? <div style={{ marginTop: 10, color: "crimson" }}>Error: {err}</div> : null}

        <div style={{ display: "grid", gap: 10, marginTop: 12, gridTemplateColumns: "1fr 1fr 1fr" }}>
          <div>
            <div style={{ fontSize: 12, color: "#333" }}>project_id (optional)</div>
            <input value={projectId} onChange={(e) => setProjectId(e.target.value)} style={{ width: "100%", padding: 8 }} />
          </div>
          <div>
            <div style={{ fontSize: 12, color: "#333" }}>series_id (optional)</div>
            <input value={seriesId} onChange={(e) => setSeriesId(e.target.value)} style={{ width: "100%", padding: 8 }} />
          </div>
          <div>
            <div style={{ fontSize: 12, color: "#333" }}>search (q)</div>
            <input value={q} onChange={(e) => setQ(e.target.value)} style={{ width: "100%", padding: 8 }} />
          </div>
        </div>

        <div style={{ display: "flex", gap: 10, marginTop: 12, flexWrap: "wrap", alignItems: "center" }}>
          <div style={{ display: "flex", gap: 6, alignItems: "center" }}>
            <span style={{ fontSize: 12 }}>kind</span>
            <select value={kind} onChange={(e) => setKind(e.target.value as any)} style={{ padding: 6 }}>
              <option value="all">all</option>
              <option value="episode">episode</option>
              <option value="video">video</option>
            </select>
          </div>

          <label style={{ display: "flex", gap: 6, alignItems: "center", fontSize: 12 }}>
            archived <input type="checkbox" checked={archived} onChange={(e) => setArchived(e.target.checked)} />
          </label>

          <div style={{ display: "flex", gap: 6, alignItems: "center" }}>
            <span style={{ fontSize: 12 }}>sort</span>
            <select value={sort} onChange={(e) => setSort(e.target.value)} style={{ padding: 6 }}>
              {SORT_OPTS.map((o) => (
                <option key={o.value} value={o.value}>
                  {o.label}
                </option>
              ))}
            </select>
          </div>

          <div style={{ display: "flex", gap: 6, alignItems: "center" }}>
            <span style={{ fontSize: 12 }}>limit</span>
            <select value={String(limit)} onChange={(e) => setLimit(Number(e.target.value))} style={{ padding: 6 }}>
              {[20, 50, 100, 200].map((n) => (
                <option key={n} value={String(n)}>
                  {n}
                </option>
              ))}
            </select>
          </div>

          <button
            onClick={() => refresh(0)}
            disabled={loading}
            style={{ padding: "8px 12px", border: "1px solid #ddd", borderRadius: 8 }}
          >
            {loading ? "Loading..." : "Refresh"}
          </button>
        </div>
      </div>

      <div style={{ padding: 12, border: "1px solid #ddd", borderRadius: 12 }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
          <h2 style={{ margin: 0 }}>Items</h2>
          <div style={{ fontSize: 12, color: "#666" }}>
            total={total} • offset={offset} • limit={limit}
          </div>
        </div>

        <div style={{ display: "flex", gap: 10, marginTop: 10, alignItems: "center" }}>
          <button
            disabled={loading || !canPrev}
            onClick={() => refresh(Math.max(0, offset - limit))}
            style={{ padding: "6px 10px" }}
          >
            Prev
          </button>
          <button
            disabled={loading || !canNext}
            onClick={() => refresh(offset + limit)}
            style={{ padding: "6px 10px" }}
          >
            Next
          </button>

          <div style={{ marginLeft: "auto", display: "flex", gap: 12 }}>
            <a href="/projects">Projects</a>
            <a href="/series">Series</a>
            <a href="/episodes_or_videos">Episodes/Videos</a>
          </div>
        </div>

        {items.length === 0 ? (
          <div style={{ marginTop: 12, color: "#666" }}>No items.</div>
        ) : (
          <div style={{ display: "grid", gap: 10, marginTop: 12 }}>
            {items.map((it) => (
              <div key={it.id} style={{ border: "1px solid #eee", borderRadius: 10, padding: 10 }}>
                <div style={{ display: "flex", justifyContent: "space-between", gap: 10 }}>
                  <div style={{ fontWeight: 700 }}>
                    [{it.kind}] {it.title}
                  </div>
                  <div style={{ fontSize: 12, color: "#666" }}>{it.created_at}</div>
                </div>

                <div style={{ fontSize: 12, color: "#666", marginTop: 6 }}>
                  project_id={it.project_id} • series_id={it.series_id}
                </div>

                <div style={{ display: "flex", gap: 12, marginTop: 10, flexWrap: "wrap" }}>
                  <a
                    href={`/episodes_or_videos/${it.id}`}
                    style={{ border: "1px solid #ddd", borderRadius: 10, padding: "6px 12px", textDecoration: "none" }}
                  >
                    Open Item
                  </a>
                  <a
                    href={`/series/${it.series_id}`}
                    style={{ border: "1px solid #ddd", borderRadius: 10, padding: "6px 12px", textDecoration: "none" }}
                  >
                    Open Series
                  </a>
                  <a
                    href={`/series?project_id=${encodeURIComponent(it.project_id)}`}
                    style={{ border: "1px solid #ddd", borderRadius: 10, padding: "6px 12px", textDecoration: "none" }}
                  >
                    Filter Series by Project
                  </a>
                </div>

                {it.synopsis_text ? (
                  <div style={{ marginTop: 10, whiteSpace: "pre-wrap" }}>{it.synopsis_text}</div>
                ) : null}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}
TSX
echo "[rc] write_feed_ui=0"
echo

echo "==[B1] local openapi must include /api/feed (code-level registration) =="
cd "$repo_root/apps/api" || exit 1
PYTHONPATH=./src "$PY" - <<'PY'
from app.main import app
paths=set(app.openapi().get("paths",{}).keys())
print("[local] has /api/feed =", ("/api/feed" in paths))
if "/api/feed" not in paths:
    raise SystemExit(3)
PY
echo "[rc] local_openapi=0"
echo
cd "$repo_root"

echo "==[B2] live openapi must include /api/feed (running server must be restarted/reloaded) =="
set +e
curl -fsS http://127.0.0.1:7000/openapi.json | "$PY" - <<'PY'
import sys, json
j=json.load(sys.stdin)
paths=set(j.get("paths",{}).keys())
print("[live] has /api/feed =", ("/api/feed" in paths))
if "/api/feed" not in paths:
    raise SystemExit(4)
PY
rc_live=$?
set -e
echo "[rc] live_openapi=$rc_live"
if [[ $rc_live -ne 0 ]]; then
  echo
  echo "[ACTION REQUIRED] Running API server does NOT expose /api/feed."
  echo "Stop the current API process and restart with reload, e.g.:"
  echo "  cd apps/api && PYTHONPATH=./src \"$PY\" -m uvicorn app.main:app --host 127.0.0.1 --port 7000 --reload"
  echo
  echo "Then re-run this script."
  exit 4
fi
echo

echo "==[B3] smoke curl /api/feed =="
curl -fsS "http://127.0.0.1:7000/api/feed?limit=50&offset=0&archived=false&sort=-created_at" | "$PY" - <<'PY'
import sys, json
j=json.load(sys.stdin)
print("[live] total =", j.get("total"), " items =", len(j.get("items",[]) or []))
PY
