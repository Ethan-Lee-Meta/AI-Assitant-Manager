cd "$repo_root/apps/api" || exit 1
PYTHONPATH=./src "$PY" -m pytest -q
echo "[rc] pytest_backend=$?"
echo
cd "$repo_root"

echo "==[C1] export+verify contracts (API must be running) =="
./scripts/export_openapi.sh
./scripts/verify_contracts.sh
echo "[rc] contracts=$?"
echo

echo "==[W9] next build web =="
cd "$repo_root/apps/web" || exit 1
npm run build
echo "[rc] next_build=$?"
echo
echo "[done] open: http://localhost:2000/feed"
