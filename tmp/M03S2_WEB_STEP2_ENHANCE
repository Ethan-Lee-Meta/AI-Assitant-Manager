s = p.read_text(encoding="utf-8")

if "Associations (placeholder)" not in s:
    print("[skip] SeriesWorkspace.tsx: placeholder not found; refusing to patch to avoid guessing.")
    sys.exit(3)

# Insert import for new component (near existing imports)
if "EpisodeOrVideoListBySeries" not in s:
    s = s.replace('import { useEffect, useState } from "react";',
