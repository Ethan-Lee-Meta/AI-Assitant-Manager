        # fallback: prepend near top
        s = needle_import + "\n" + s

if needle_include not in s:
    if series_include in s:
        s = s.replace(series_include, series_include + "\n    " + needle_include)
    else:
        # fallback: append at end of register function if recognizable
        if "def register_modules" in s:
            s = s + "\n" + needle_include + "\n"
        else:
            s = s + "\n" + needle_include + "\n"

p.write_text(s, encoding="utf-8")
