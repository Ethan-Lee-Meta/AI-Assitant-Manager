# 4) 写 SQLite Store（episodes_or_videos/store_sqlite.py）
cat > "$MOD_DIR/store_sqlite.py" <<'EOF'
from __future__ import annotations

from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple
import os
import sqlite3
import uuid


def _now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def _default_db_path() -> str:
    # Align with other sqlite-based modules (best-effort)
    # Use env if present; otherwise local file under apps/api/.data
    return (
        os.getenv("AAM_SQLITE_PATH")
        or os.getenv("SQLITE_PATH")
        or str(Path("apps/api/.data/app.sqlite").resolve())
    )


def _connect() -> sqlite3.Connection:
    path = _default_db_path()
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    return conn


def _ensure(conn: sqlite3.Connection) -> None:
    conn.execute(
        """
        CREATE TABLE IF NOT EXISTS episodes_or_videos (
          id TEXT PRIMARY KEY,
          project_id TEXT NOT NULL,
          series_id TEXT NOT NULL,
          title TEXT NOT NULL,
          synopsis_text TEXT,
          kind TEXT NOT NULL,
          order_index INTEGER,
          script_text TEXT,
          assembly_preset_id TEXT,
          created_at TEXT NOT NULL,
          updated_at TEXT,
          archived_at TEXT
        )
        """
    )
    conn.execute("CREATE INDEX IF NOT EXISTS idx_eov_project ON episodes_or_videos(project_id)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_eov_series ON episodes_or_videos(series_id)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_eov_kind ON episodes_or_videos(kind)")
    conn.execute("CREATE INDEX IF NOT EXISTS idx_eov_archived ON episodes_or_videos(archived_at)")
    conn.commit()


def create(payload: Dict[str, Any]) -> Dict[str, Any]:
    conn = _connect()
    _ensure(conn)
    eid = uuid.uuid4().hex
    now = _now_iso()

    conn.execute(
        """
        INSERT INTO episodes_or_videos(
          id, project_id, series_id, title, synopsis_text, kind,
          order_index, script_text, assembly_preset_id,
          created_at, updated_at, archived_at
        )
        VALUES(?,?,?,?,?,?,?,?,?,?,?,?)
        """,
        (
            eid,
            payload["project_id"],
            payload["series_id"],
            payload["title"],
            payload.get("synopsis_text"),
            payload["kind"],
            payload.get("order_index"),
            payload.get("script_text"),
            payload.get("assembly_preset_id"),
            now,
            now,
            None,
        ),
    )
    conn.commit()
    return get(eid)


def get(episode_or_video_id: str) -> Dict[str, Any]:
    conn = _connect()
    _ensure(conn)
    row = conn.execute(
        "SELECT * FROM episodes_or_videos WHERE id=?",
        (episode_or_video_id,),
    ).fetchone()
    if row is None:
        raise KeyError("NOT_FOUND")
    return dict(row)


def update(episode_or_video_id: str, patch: Dict[str, Any]) -> Dict[str, Any]:
    cur = get(episode_or_video_id)  # raises if missing
    conn = _connect()
    _ensure(conn)

    merged = {**cur, **patch}
    merged["updated_at"] = _now_iso()

    conn.execute(
        """
        UPDATE episodes_or_videos
        SET
          title=?,
          synopsis_text=?,
          order_index=?,
          script_text=?,
          assembly_preset_id=?,
          kind=?,
          series_id=?,
          project_id=?,
          updated_at=?,
          archived_at=?
        WHERE id=?
        """,
        (
            merged["title"],
            merged.get("synopsis_text"),
            merged.get("order_index"),
            merged.get("script_text"),
            merged.get("assembly_preset_id"),
            merged["kind"],
            merged["series_id"],
            merged["project_id"],
            merged["updated_at"],
            merged.get("archived_at"),
            episode_or_video_id,
        ),
    )
    conn.commit()
    return get(episode_or_video_id)


def list_items(
    *,
    project_id: str,
    series_id: Optional[str],
    kind: Optional[str],
    q: Optional[str],
    archived: bool,
    limit: int,
    offset: int,
    sort: str,
) -> Tuple[List[Dict[str, Any]], int]:
    conn = _connect()
    _ensure(conn)

    where: List[str] = []
    args: List[Any] = []

    where.append("project_id = ?")
    args.append(project_id)

    if not archived:
        where.append("archived_at IS NULL")

    if series_id:
        where.append("series_id = ?")
        args.append(series_id)

    if kind:
        where.append("kind = ?")
        args.append(kind)

    if q:
        # best-effort "quick search"
        where.append("(title LIKE ? OR synopsis_text LIKE ? OR script_text LIKE ?)")
        like = f"%{q}%"
        args.extend([like, like, like])

    where_sql = " WHERE " + " AND ".join(where)

    # sort: field:asc|desc ; default created_at:desc
    sort = (sort or "created_at:desc").strip()
    field, _, direction = sort.partition(":")
    field = field.strip()
    direction = (direction or "desc").strip().lower()

    allowed = {"created_at", "updated_at", "order_index", "title"}
    if field not in allowed:
        field = "created_at"
    if direction not in {"asc", "desc"}:
        direction = "desc"

    total_row = conn.execute(
        f"SELECT COUNT(1) AS c FROM episodes_or_videos{where_sql}",
        args,
    ).fetchone()
    total = int(total_row["c"]) if total_row else 0

    rows = conn.execute(
        f"""
        SELECT * FROM episodes_or_videos
        {where_sql}
        ORDER BY {field} {direction}
        LIMIT ? OFFSET ?
        """,
        [*args, limit, offset],
    ).fetchall()

    return [dict(r) for r in rows], total
EOF

# 5) 写 Service（episodes_or_videos/service.py）
cat > "$MOD_DIR/service.py" <<'EOF'
from __future__ import annotations

from typing import Optional

from app.core.errors import AppError
from . import store_sqlite
from .dto import EpisodeOrVideoCreate, EpisodeOrVideoPatch, EpisodeOrVideoKind


def create_episode_or_video(payload: EpisodeOrVideoCreate):
    d = payload.model_dump()
    d["kind"] = d["kind"].value if isinstance(d.get("kind"), EpisodeOrVideoKind) else d.get("kind")
    return store_sqlite.create(d)


def get_episode_or_video(episode_or_video_id: str):
    try:
        return store_sqlite.get(episode_or_video_id)
    except KeyError:
        raise AppError("NOT_FOUND", "EpisodeOrVideo not found", status_code=404)


def patch_episode_or_video(episode_or_video_id: str, patch: EpisodeOrVideoPatch):
    try:
        d = patch.model_dump(exclude_unset=True)
        if "archived_at" in d and d["archived_at"] is not None:
            d["archived_at"] = d["archived_at"].isoformat()
        if "kind" in d and isinstance(d.get("kind"), EpisodeOrVideoKind):
            d["kind"] = d["kind"].value
        return store_sqlite.update(episode_or_video_id, d)
    except KeyError:
        raise AppError("NOT_FOUND", "EpisodeOrVideo not found", status_code=404)


def list_episodes_or_videos(
    *,
    project_id: str,
    series_id: Optional[str],
    kind: Optional[EpisodeOrVideoKind],
    q: Optional[str],
    archived: bool,
    limit: int,
    offset: int,
    sort: str,
):
    kind_s = kind.value if kind is not None else None
    items, total = store_sqlite.list_items(
        project_id=project_id,
        series_id=series_id,
        kind=kind_s,
        q=q,
        archived=archived,
        limit=limit,
        offset=offset,
        sort=sort,
    )
    return items, total
EOF

# 6) 写 Router（episodes_or_videos/router.py）
cat > "$MOD_DIR/router.py" <<'EOF'
from __future__ import annotations

from typing import Optional

from fastapi import APIRouter, Query

from .dto import (
    EpisodeOrVideo,
    EpisodeOrVideoCreate,
    EpisodeOrVideoKind,
    EpisodeOrVideoListResponse,
    EpisodeOrVideoPatch,
)
from .service import (
    create_episode_or_video,
    get_episode_or_video,
    list_episodes_or_videos,
    patch_episode_or_video,
)

router = APIRouter(prefix="/api/episodes_or_videos", tags=["episodes_or_videos"])


@router.post("", response_model=EpisodeOrVideo)
def create(payload: EpisodeOrVideoCreate):
    return create_episode_or_video(payload)


@router.get("/{episode_or_video_id}", response_model=EpisodeOrVideo)
def get_one(episode_or_video_id: str):
    return get_episode_or_video(episode_or_video_id)


@router.patch("/{episode_or_video_id}", response_model=EpisodeOrVideo)
def patch_one(episode_or_video_id: str, patch: EpisodeOrVideoPatch):
    return patch_episode_or_video(episode_or_video_id, patch)


@router.get("", response_model=EpisodeOrVideoListResponse)
def list_all(
    project_id: str = Query(..., min_length=1),
    series_id: Optional[str] = None,
    kind: Optional[EpisodeOrVideoKind] = None,
    q: Optional[str] = None,
    archived: bool = False,
    limit: int = Query(20, ge=1, le=200),
    offset: int = Query(0, ge=0),
    sort: str = "created_at:desc",
):
    items, total = list_episodes_or_videos(
        project_id=project_id,
        series_id=series_id,
        kind=kind,
        q=q,
        archived=archived,
        limit=limit,
        offset=offset,
        sort=sort,
    )
    return {"items": items, "total": total, "limit": limit, "offset": offset}
EOF

