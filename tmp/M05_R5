"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import { listPrompts, type Prompt, type PromptKind } from "../../lib/api/prompts";

export function PromptList() {
  const [items, setItems] = useState<Prompt[]>([]);
  const [total, setTotal] = useState<number>(0);
  const [loading, setLoading] = useState<boolean>(false);
  const [err, setErr] = useState<string>("");

  const [q, setQ] = useState<string>("");
  const [kind, setKind] = useState<PromptKind | "">("");

  async function reload() {
    setLoading(true);
    setErr("");
    try {
      const resp = await listPrompts({ q: q || undefined, prompt_kind: (kind || undefined) as any, limit: 50, offset: 0 });
      setItems(resp.items || []);
      setTotal(resp.total || 0);
    } catch (e: any) {
      setErr(e?.message || "Failed to load prompts");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void reload();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  return (
    <div className="space-y-4">
      <div className="flex items-end gap-3">
        <label className="space-y-1">
          <div className="text-sm">Search (q)</div>
          <input className="rounded border px-2 py-1" value={q} onChange={(e) => setQ(e.target.value)} />
        </label>

        <label className="space-y-1">
          <div className="text-sm">Kind</div>
          <select className="rounded border px-2 py-1" value={kind} onChange={(e) => setKind(e.target.value as any)}>
            <option value="">(all)</option>
            <option value="text2image">text2image</option>
            <option value="image2image">image2image</option>
            <option value="text2video">text2video</option>
            <option value="image2video">image2video</option>
            <option value="general">general</option>
          </select>
        </label>

        <button className="rounded bg-black px-3 py-2 text-white" onClick={() => void reload()} disabled={loading}>
          {loading ? "Loading..." : "Reload"}
        </button>
      </div>

      {err ? <div className="text-sm text-red-600">{err}</div> : null}

      <div className="text-sm opacity-70">Total: {total}</div>

      <div className="space-y-2">
        {items.map((p) => (
          <div key={p.id} className="rounded border p-3">
            <div className="flex items-center justify-between">
              <Link className="font-semibold underline" href={`/prompts/${p.id}`}>
                {p.name}
              </Link>
              <div className="text-sm opacity-70">{p.prompt_kind}</div>
            </div>
            <div className="text-xs opacity-70">id: {p.id}</div>
          </div>
        ))}
      </div>
    </div>
  );
}
