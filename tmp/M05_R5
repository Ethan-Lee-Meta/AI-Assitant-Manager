"use client";

import { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import { getPrompt, type Prompt } from "../../lib/api/prompts";
import { createPromptVersion, listPromptVersions, type PromptVersion } from "../../lib/api/prompt_versions";

function safeJsonParse(text: string, fallback: any, onError: (msg: string) => void): any {
  const trimmed = text.trim();
  if (!trimmed) return fallback;
  try {
    return JSON.parse(trimmed);
  } catch (e: any) {
    onError(e?.message ? `JSON parse error: ${e.message}` : "JSON parse error");
    return null;
  }
}

export function PromptDetail(props: { promptId: string }) {
  const promptId = props.promptId;

  const [prompt, setPrompt] = useState<Prompt | null>(null);
  const [versions, setVersions] = useState<PromptVersion[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [err, setErr] = useState<string>("");

  const [projectId, setProjectId] = useState<string>("");
  const [versionLabel, setVersionLabel] = useState<string>("v1");
  const [resolvedText, setResolvedText] = useState<string>("");
  const [resolvedParamsText, setResolvedParamsText] = useState<string>("{}");
  const [workflowRefText, setWorkflowRefText] = useState<string>("{}");
  const [roleBindingsText, setRoleBindingsText] = useState<string>("[]");

  const effectiveProjectId = useMemo(() => {
    return projectId || prompt?.project_id || "";
  }, [projectId, prompt]);

  async function reloadAll() {
    setLoading(true);
    setErr("");
    try {
      const p = await getPrompt(promptId);
      setPrompt(p);
      if (!resolvedText) setResolvedText(p.content_text || "");
      if (!projectId && p.project_id) setProjectId(p.project_id);

      if (p.project_id) {
        const vr = await listPromptVersions({ project_id: p.project_id, prompt_id: p.id, limit: 50, offset: 0 });
        setVersions(vr.items || []);
      } else {
        setVersions([]);
      }
    } catch (e: any) {
      setErr(e?.message || "Failed to load prompt");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    void reloadAll();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [promptId]);

  async function onCreateVersion() {
    setErr("");
    if (!prompt) return;

    const pid = effectiveProjectId;
    if (!pid) {
      setErr("project_id is required to create PromptVersion (fill Project Id).");
      return;
    }

    let localErr = "";
    const resolved_params = safeJsonParse(resolvedParamsText, {}, (m) => (localErr = m));
    if (localErr) {
      setErr(localErr);
      return;
    }
    const workflow_ref = safeJsonParse(workflowRefText, {}, (m) => (localErr = m));
    if (localErr) {
      setErr(localErr);
      return;
    }
    const role_bindings = safeJsonParse(roleBindingsText, [], (m) => (localErr = m));
    if (localErr) {
      setErr(localErr);
      return;
    }

    try {
      await createPromptVersion({
        project_id: pid,
        prompt_id: prompt.id,
        version_label: versionLabel || "v1",
        prompt_kind: prompt.prompt_kind,
        resolved_prompt_text: resolvedText || prompt.content_text,
        resolved_params: resolved_params || {},
        workflow_ref: workflow_ref || {},
        role_bindings: role_bindings || [],
      });
      await reloadAll();
    } catch (e: any) {
      setErr(e?.message || "Create PromptVersion failed");
    }
  }

  if (loading) return <div>Loading...</div>;

  if (!prompt) {
    return (
      <div className="space-y-4">
        <div className="text-sm text-red-600">{err || "Prompt not found"}</div>
        <Link className="underline" href="/prompts">
          Back
        </Link>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <div className="space-y-1">
          <div className="text-xl font-semibold">{prompt.name}</div>
          <div className="text-sm opacity-70">
            id: {prompt.id} · kind: {prompt.prompt_kind} · project_id: {prompt.project_id || "(null)"}
          </div>
        </div>
        <Link className="underline" href="/prompts">
          Back
        </Link>
      </div>

      {err ? <div className="text-sm text-red-600">{err}</div> : null}

      <div className="rounded-lg border p-4 space-y-3">
        <div className="font-semibold">Create PromptVersion</div>

        <div className="grid gap-3 md:grid-cols-2">
          <label className="space-y-1">
            <div className="text-sm">Project Id (required)</div>
            <input
              className="w-full rounded border px-2 py-1"
              value={effectiveProjectId}
              onChange={(e) => setProjectId(e.target.value)}
              placeholder="project_id"
            />
          </label>

          <label className="space-y-1">
            <div className="text-sm">Version Label</div>
            <input
              className="w-full rounded border px-2 py-1"
              value={versionLabel}
              onChange={(e) => setVersionLabel(e.target.value)}
              placeholder="v1"
            />
          </label>
        </div>

        <label className="space-y-1 block">
          <div className="text-sm">Resolved Prompt Text</div>
          <textarea
            className="w-full rounded border px-2 py-1 font-mono text-sm"
            rows={6}
            value={resolvedText}
            onChange={(e) => setResolvedText(e.target.value)}
          />
        </label>

        <div className="grid gap-3 md:grid-cols-2">
          <label className="space-y-1 block">
            <div className="text-sm">resolved_params (JSON)</div>
            <textarea
              className="w-full rounded border px-2 py-1 font-mono text-sm"
              rows={6}
              value={resolvedParamsText}
              onChange={(e) => setResolvedParamsText(e.target.value)}
            />
          </label>

          <label className="space-y-1 block">
            <div className="text-sm">workflow_ref (JSON)</div>
            <textarea
              className="w-full rounded border px-2 py-1 font-mono text-sm"
              rows={6}
              value={workflowRefText}
              onChange={(e) => setWorkflowRefText(e.target.value)}
            />
          </label>
        </div>

        <label className="space-y-1 block">
          <div className="text-sm">role_bindings (JSON array)</div>
          <textarea
            className="w-full rounded border px-2 py-1 font-mono text-sm"
            rows={4}
            value={roleBindingsText}
            onChange={(e) => setRoleBindingsText(e.target.value)}
          />
        </label>

        <button className="rounded bg-black px-3 py-2 text-white" onClick={() => void onCreateVersion()}>
          Create PromptVersion
        </button>
      </div>

      <div className="rounded-lg border p-4 space-y-3">
        <div className="font-semibold">PromptVersions ({versions.length})</div>
        {versions.length === 0 ? (
          <div className="text-sm opacity-70">No versions yet.</div>
        ) : (
          <div className="space-y-2">
            {versions.map((v) => (
              <div key={v.id} className="rounded border p-2">
                <div className="text-sm">
                  <span className="font-semibold">{v.version_label}</span> · {v.id}
                </div>
                <div className="text-xs opacity-70">{v.created_at}</div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}
