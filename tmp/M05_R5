import { apiFetch, apiGet, apiPost } from "./client";

export type PromptKind = "text2image" | "image2image" | "text2video" | "image2video" | "general";

export interface Prompt {
  id: string;
  project_id?: string | null;
  name: string;
  prompt_kind: PromptKind;
  content_text: string;
  composition_blocks?: unknown[] | null;
  searchable_text?: string | null;
  created_at: string;
  updated_at?: string | null;
  archived_at?: string | null;
}

export interface PromptCreate {
  project_id?: string | null;
  name: string;
  prompt_kind: PromptKind;
  content_text: string;
  composition_blocks?: unknown[] | null;
  searchable_text?: string | null;
}

export interface PromptPatch {
  name?: string | null;
  content_text?: string | null;
  composition_blocks?: unknown[] | null;
  searchable_text?: string | null;
  archived_at?: string | null;
}

export interface PromptListResponse {
  items: Prompt[];
  total: number;
  limit: number;
  offset: number;
}

function buildQuery(params: Record<string, string | number | boolean | undefined | null>): string {
  const q = new URLSearchParams();
  for (const [k, v] of Object.entries(params)) {
    if (v === undefined || v === null) continue;
    q.set(k, String(v));
  }
  const s = q.toString();
  return s ? `?${s}` : "";
}

export async function listPrompts(params: {
  q?: string;
  prompt_kind?: PromptKind;
  project_id?: string;
  archived?: boolean;
  limit?: number;
  offset?: number;
  sort?: string;
} = {}): Promise<PromptListResponse> {
  const qs = buildQuery(params as any);
  return apiGet<PromptListResponse>(`/api/prompts${qs}`);
}

export async function getPrompt(id: string): Promise<Prompt> {
  return apiGet<Prompt>(`/api/prompts/${encodeURIComponent(id)}`);
}

export async function createPrompt(body: PromptCreate): Promise<Prompt> {
  return apiPost<Prompt>("/api/prompts", body);
}

export async function patchPrompt(id: string, body: PromptPatch): Promise<Prompt> {
  return apiFetch<Prompt>(`/api/prompts/${encodeURIComponent(id)}`, {
    method: "PATCH",
    body: JSON.stringify(body),
    headers: { "Content-Type": "application/json" },
  });
}
