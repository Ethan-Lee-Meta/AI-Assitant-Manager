echo "[ok] wrote: $TARGET_PAGE"

# ----------------------------
# 3) Web build (won't exit terminal)
# ----------------------------
echo "[info] running next build..."
(
  cd "$repo_root/apps/web" || exit 1
  npm ci 2>/dev/null || npm install
  npm run build
)
rc=$?
echo "[info] next build rc=$rc"

# ----------------------------
# 4) Robust smoke: start api+web, wait, curl without pipe masking rc
# ----------------------------
echo "[info] smoke: start api(7000) + web(2000) and curl /prompts"

# stop old if exists
if [ -f /tmp/api_7000.pid ]; then
  kill "$(cat /tmp/api_7000.pid)" 2>/dev/null || true
  rm -f /tmp/api_7000.pid
fi
if [ -f /tmp/web_2000.pid ]; then
  kill "$(cat /tmp/web_2000.pid)" 2>/dev/null || true
  rm -f /tmp/web_2000.pid
fi

# start api
(
  cd "$repo_root/apps/api" || exit 1
  source "$repo_root/.venv/Scripts/activate" 2>/dev/null || true
  PYTHONPATH=./src uvicorn app.main:app --host 0.0.0.0 --port 7000 > /tmp/api_7000.log 2>&1 &
  echo $! > /tmp/api_7000.pid
  echo "[ok] api pid=$(cat /tmp/api_7000.pid)"
)

# wait api health
api_ok=0
for i in $(seq 1 30); do
  curl -sS http://localhost:7000/health -o /tmp/health.json
  if [ $? -eq 0 ]; then api_ok=1; break; fi
  sleep 0.3
done
if [ $api_ok -eq 1 ]; then
  echo "[ok] api health:"
  cat /tmp/health.json; echo
else
  echo "[fail] api not ready; tail log:"
  tail -n 120 /tmp/api_7000.log 2>/dev/null || true
fi

# start web (dev)
(
  cd "$repo_root/apps/web" || exit 1
  npm run dev -- -p 2000 > /tmp/web_2000.log 2>&1 &
  echo $! > /tmp/web_2000.pid
  echo "[ok] web pid=$(cat /tmp/web_2000.pid)"
)

# wait web /prompts
web_ok=0
for i in $(seq 1 50); do
  curl -sS http://localhost:2000/prompts -o /tmp/web_prompts.html
  if [ $? -eq 0 ]; then web_ok=1; break; fi
  sleep 0.3
done

if [ $web_ok -eq 1 ]; then
  echo "[ok] web /prompts fetched (first 200 bytes):"
  head -c 200 /tmp/web_prompts.html; echo
else
  echo "[fail] web not reachable on :2000"
  echo "[info] tail /tmp/web_2000.log:"
  tail -n 160 /tmp/web_2000.log 2>/dev/null || true
fi

# cleanup
if [ -f /tmp/web_2000.pid ]; then
  kill "$(cat /tmp/web_2000.pid)" 2>/dev/null || true
  echo "[ok] killed web pid=$(cat /tmp/web_2000.pid)"
  rm -f /tmp/web_2000.pid
fi
if [ -f /tmp/api_7000.pid ]; then
  kill "$(cat /tmp/api_7000.pid)" 2>/dev/null || true
  echo "[ok] killed api pid=$(cat /tmp/api_7000.pid)"
  rm -f /tmp/api_7000.pid
fi

echo "[done] M05_WEB_R3 completed."
exit 0
