from __future__ import annotations

from typing import Optional

from fastapi import APIRouter, Query

from app.modules.episodes_or_videos.dto import EpisodeOrVideoKind
from app.modules.feed.dto import FeedListResponse
from app.modules.feed import service

router = APIRouter(prefix="/api/feed", tags=["feed"])


@router.get("", response_model=FeedListResponse)
def list_feed(
    project_id: Optional[str] = Query(default=None),
    series_id: Optional[str] = Query(default=None),
    kind: Optional[EpisodeOrVideoKind] = Query(default=None),
    limit: int = Query(default=50, ge=1, le=200),
    offset: int = Query(default=0, ge=0),
    sort: Optional[str] = Query(default="-created_at"),
    q: Optional[str] = Query(default=None),
    archived: bool = Query(default=False),
) -> FeedListResponse:
    return service.list_feed(
        project_id=project_id,
        series_id=series_id,
        kind=str(kind) if kind is not None else None,
        q=q,
        archived=archived,
        limit=limit,
        offset=offset,
        sort=sort,
    )
PY

echo "==[S3] patch registry: append feed router =="
python - <<'PY'
import re
from pathlib import Path

p = Path("apps/api/src/app/modules/_registry.py")
s = p.read_text(encoding="utf-8")

if "modules.feed.router" in s or "feed.router" in s:
    print("[ok] registry already patched")
    raise SystemExit(0)

# Insert just before "return routers" inside get_module_routers, minimal risk.
m = re.search(r"(?m)^\s*return\s+routers\s*$", s)
if not m:
    print("[err] cannot find 'return routers' anchor in _registry.py")
    raise SystemExit(3)

indent = re.match(r"^(\s*)", m.group(0)).group(1)
block = (
    f"{indent}# feed (read-only aggregate)\n"
    f"{indent}from app.modules.feed.router import router as feed_router\n"
    f"{indent}routers.append(feed_router)\n\n"
)
s2 = s[:m.start()] + block + s[m.start():]
p.write_text(s2, encoding="utf-8")
print("[ok] patched registry (_registry.py)")
PY
