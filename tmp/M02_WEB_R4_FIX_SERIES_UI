                  )}

                  __DEL_BTN__
                </div>
              </div>
            ))}
            {items.length === 0 ? (
              <div style={{ color: "#777" }}>
                No items. Ensure <code>project_id</code> is set, then Refresh.
              </div>
            ) : null}
          </div>
        </div>
      </div>
    </div>
  );
}
