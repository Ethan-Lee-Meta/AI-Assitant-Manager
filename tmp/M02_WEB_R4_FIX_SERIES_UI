      return;
    }
    setLoading(true);
    try {
      await createSeries({
        project_id: projectId.trim(),
        name: name.trim(),
        style_text: styleText || null,
        continuity_text: continuityText || null,
      });
      setName("");
      setStyleText("");
      setContinuityText("");
      await refresh();
    } catch (e: any) {
      setErr(e?.message || "create failed");
    } finally {
      setLoading(false);
    }
  }

  function onClearQ() {
    setQ("");
  }

  async function archive(id: string) {
    setErr(null);
    setLoading(true);
