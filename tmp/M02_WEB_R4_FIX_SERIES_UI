def rel_import(from_dir: Path, to_file: Path) -> str:
    rel = os.path.relpath(to_file, from_dir)
    rel = rel.replace("\\", "/")
    if rel.endswith(".ts"):
        rel = rel[:-3]
    if not rel.startswith("."):
        rel = "./" + rel
    return rel

