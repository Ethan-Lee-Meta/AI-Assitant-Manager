backup () {
  local f="$1"
  if [ -f "$f" ]; then
    cp -f "$f" "$f.bak.${ts}"
    echo "[ok] backup -> $f.bak.${ts}"
  fi
}

write_file () {
  local f="$1"
  shift
  mkdir -p "$(dirname "$f")"
  backup "$f"
  cat > "$f" <<'EOF'
'"$@"'
EOF
  echo "[ok] wrote: $f"
}

