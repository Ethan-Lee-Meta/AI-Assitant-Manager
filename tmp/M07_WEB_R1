import { apiGet, apiPost } from "./client";

export type Provider = {
  id: string;
  name: string;
  provider_type: string;
  supported_kinds: string[];
  endpoint_config: Record<string, unknown>;
  is_enabled: boolean;
  created_at?: string;
  updated_at?: string;
  [k: string]: unknown;
};

export type ProviderListResponse = {
  items: Provider[];
  total: number;
  page: number;
  page_size: number;
};

export async function listProviders(params?: { q?: string; type?: string; enabled?: boolean; page?: number; page_size?: number }) {
  const usp = new URLSearchParams();
  if (params?.q) usp.set("q", params.q);
  if (params?.type) usp.set("type", params.type);
  if (typeof params?.enabled === "boolean") usp.set("enabled", String(params.enabled));
  usp.set("page", String(params?.page ?? 1));
  usp.set("page_size", String(params?.page_size ?? 50));
  const qs = usp.toString();
  return apiGet<ProviderListResponse>(`/api/providers${qs ? `?${qs}` : ""}`);
}

export async function createProvider(input: {
  name: string;
  provider_type: string;
  supported_kinds: string[];
  endpoint_config: Record<string, unknown>;
  is_enabled: boolean;
}) {
  return apiPost<Provider>(`/api/providers`, input);
}
TS

