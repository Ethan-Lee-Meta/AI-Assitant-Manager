cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# ===== env =====
source .venv/Scripts/activate 2>/dev/null || true

# ===== patch registry (idempotent; no marker dependency) =====
REG="apps/api/src/app/modules/_registry.py"
if [ ! -f "$REG" ]; then
  echo "[fatal] missing: $REG"
  exit 2
fi

cp "$REG" "$REG.bak.$(date +%Y%m%d_%H%M%S)"
echo "[ok] backup: $REG.bak.$(date +%Y%m%d_%H%M%S)"

python - <<'PY'
from __future__ import annotations
from pathlib import Path
import re, sys

p = Path("apps/api/src/app/modules/_registry.py")
s = p.read_text(encoding="utf-8").replace("\r\n", "\n")

# Normalize: if early shape "return []", upgrade to routers list form.
if re.search(r"^\s*return\s*\[\s*\]\s*$", s, flags=re.M) and "routers:" not in s:
    # Ensure routers var exists after the comment line
    if "def get_module_routers" not in s:
        print("[fatal] cannot find get_module_routers()")
        sys.exit(2)

    # Insert routers var after the first comment inside the function (best-effort)
    s = re.sub(
        r"(def get_module_routers\(\)\s*->\s*List\[APIRouter\]:\n)(\s*#.*\n)",
        r"\1\2    routers: List[APIRouter] = []\n\n",
        s,
        count=1,
    )

    # Replace return [] -> return routers
    s = re.sub(r"^\s*return\s*\[\s*\]\s*$", "    return routers", s, flags=re.M)

# Now we require "return routers"
m = re.search(r"^\s*return\s+routers\s*$", s, flags=re.M)
if not m:
    print("[fatal] cannot find 'return routers' in _registry.py; please paste current file")
    sys.exit(2)

def ensure_block(tag: str, import_line: str, append_line: str) -> str:
    return (
        f"    # --- {tag} begin ---\n"
        f"    {import_line}\n"
        f"    {append_line}\n"
        f"    # --- {tag} end ---\n\n"
    )

need = []
if "from .providers.router import router as providers_router" not in s:
    need.append(ensure_block(
        "M07 Providers",
        "from .providers.router import router as providers_router",
        "routers.append(providers_router)",
    ))
if "from .workflows.router import router as workflows_router" not in s:
    need.append(ensure_block(
        "M07 Workflows",
        "from .workflows.router import router as workflows_router",
        "routers.append(workflows_router)",
    ))
if "from .tools.router import router as tools_router" not in s:
    need.append(ensure_block(
        "M07 Tools",
        "from .tools.router import router as tools_router",
        "routers.append(tools_router)",
    ))

if not need:
    print("[ok] registry already contains M07 routers; no change")
    sys.exit(0)

ins = "".join(need)

# Insert before 'return routers'
s2 = re.sub(r"^(\s*)return\s+routers\s*$", ins + r"\1return routers", s, flags=re.M, count=1)
p.write_text(s2, encoding="utf-8")
print("[ok] registry patched: inserted M07 routers before return")
PY

echo "[info] registry grep:"
rg -n "M07 (Providers|Workflows|Tools)|providers_router|workflows_router|tools_router" "$REG" || true

# ===== backend tests =====
echo "[info] running backend tests..."
cd apps/api
PYTHONPATH=./src pytest -q
rc=$?
echo "[info] pytest rc=$rc"
cd - >/dev/null || true
if [ $rc -ne 0 ]; then
  echo "[fatal] pytest failed; abort before contract export"
  exit $rc
fi

# ===== start api server (7000) for contract export =====
echo "[info] starting api server (7000) in background for contract export..."
(
  cd apps/api || exit 1
  source ../../.venv/Scripts/activate 2>/dev/null || true
  PYTHONPATH=./src uvicorn app.main:app --host 0.0.0.0 --port 7000 > /tmp/api_7000.log 2>&1 &
  echo $! > /tmp/api_7000.pid
  echo "[ok] api started pid=$(cat /tmp/api_7000.pid)"
)

curl -sS http://localhost:7000/health -o /tmp/h.json
echo "[info] api /health:"
cat /tmp/h.json; echo

# ===== bump contract version (YYYYMMDD-NN) =====
python - <<'PY'
from __future__ import annotations
from pathlib import Path
import re
from datetime import datetime

p = Path("packages/contracts/contract_version.txt")
old = p.read_text(encoding="utf-8").strip() if p.exists() else ""
today = datetime.now().strftime("%Y%m%d")

m = re.fullmatch(r"(\d{8})-(\d{2})", old)
if m and m.group(1) == today:
    nn = int(m.group(2)) + 1
    new = f"{today}-{nn:02d}"
else:
    new = f"{today}-01"

p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(new + "\n", encoding="utf-8")
print(f"[ok] contract_version: {old!r} -> {new!r}")
PY

# ===== export + verify =====
./scripts/export_openapi.sh
rc=$?
echo "[info] export_openapi rc=$rc"
if [ $rc -ne 0 ]; then
  echo "[fatal] export_openapi failed"
fi

./scripts/verify_contracts.sh
rc=$?
echo "[info] verify_contracts rc=$rc"

# ===== stop api server =====
echo "[info] stopping api server..."
if [ -f /tmp/api_7000.pid ]; then
  kill "$(cat /tmp/api_7000.pid)" 2>/dev/null || true
  echo "[ok] killed pid=$(cat /tmp/api_7000.pid)"
fi

echo "[done] M07 registry fix + tests + contract export completed."
