"use client";
import { useEffect, useState } from "react";
import { apiGet, apiPost } from "../../../../src/lib/api/client";

type Provider = { id: string; name: string; provider_type: string; is_enabled: boolean; supported_kinds: string[]; created_at: string; };
type ListResp<T> = { items: T[]; total: number; limit: number; offset: number };

export default function ProvidersPage() {
  const [items, setItems] = useState<Provider[]>([]);
  const [name, setName] = useState("DemoProvider");
  const [loading, setLoading] = useState(false);

  async function reload() {
    setLoading(true);
    try {
      const r = await apiGet<ListResp<Provider>>("/api/providers?limit=50&offset=0");
      setItems(r.items || []);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => { void reload(); }, []);

  async function createOne() {
    await apiPost<Provider>("/api/providers", {
      name,
      provider_type: "http_api",
      supported_kinds: ["text2image"],
      endpoint_config: { base_url: "http://example" },
      is_enabled: true
    });
    await reload();
  }

  return (
    <div style={{ padding: 16, display: "flex", flexDirection: "column", gap: 12 }}>
      <h1 style={{ fontSize: 18, fontWeight: 600 }}>Settings / Providers</h1>
      <div style={{ display: "flex", gap: 8 }}>
        <input value={name} onChange={(e) => setName(e.target.value)} style={{ padding: 8, border: "1px solid #ccc", borderRadius: 6 }} />
        <button onClick={createOne} style={{ padding: "8px 12px" }}>Create</button>
        <button onClick={reload} style={{ padding: "8px 12px" }}>{loading ? "Loading..." : "Reload"}</button>
      </div>
      <div style={{ border: "1px solid #ddd", borderRadius: 8 }}>
        {items.map(p => (
          <div key={p.id} style={{ padding: 10, borderTop: "1px solid #eee" }}>
            <b>{p.name}</b> — {p.provider_type} — enabled={String(p.is_enabled)}
          </div>
        ))}
        {items.length === 0 ? <div style={{ padding: 10 }}>(empty)</div> : null}
      </div>
    </div>
  );
}
EOF

