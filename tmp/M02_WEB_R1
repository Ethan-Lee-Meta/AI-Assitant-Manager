export type Series = {
  id: string;
  project_id: string;
  name: string;
  style_text?: string | null;
  continuity_text?: string | null;
  archived_at?: string | null;
  created_at?: string;
  updated_at?: string;
};

export type SeriesCreate = {
  project_id: string;
  name: string;
  style_text?: string | null;
  continuity_text?: string | null;
};

export type SeriesPatch = {
  name?: string;
  style_text?: string | null;
  continuity_text?: string | null;
  archived_at?: string | null;
};

export type ListResp<T> = {
  items: T[];
  total: number;
  limit?: number;
  offset?: number;
};

async function apiFetch<T>(path: string, init?: RequestInit): Promise<T> {
  const r = await fetch(path, {
    ...init,
    headers: { ...(init?.headers || {}), "Accept": "application/json" },
  });

  if (r.ok) {
    return (await r.json()) as T;
  }

  const text = await r.text();
  try {
    const js = JSON.parse(text);
    const msg =
      js?.error?.message ||
      js?.detail ||
      `HTTP ${r.status}`;
    throw new Error(msg);
  } catch {
    throw new Error(text || `HTTP ${r.status}`);
  }
}

export async function listSeries(params: {
  project_id: string;
  q?: string;
  archived?: boolean;
  limit?: number;
  offset?: number;
  sort?: string;
}): Promise<ListResp<Series>> {
  const usp = new URLSearchParams();
  usp.set("project_id", params.project_id);
  if (params.q) usp.set("q", params.q);
  if (typeof params.archived === "boolean") usp.set("archived", String(params.archived));
  if (typeof params.limit === "number") usp.set("limit", String(params.limit));
  if (typeof params.offset === "number") usp.set("offset", String(params.offset));
  if (params.sort) usp.set("sort", params.sort);
  return apiFetch<ListResp<Series>>(`/api/series?${usp.toString()}`, { method: "GET" });
}

export async function createSeries(payload: SeriesCreate): Promise<Series> {
  return apiFetch<Series>(`/api/series`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload),
  });
}

export async function getSeries(series_id: string): Promise<Series> {
  return apiFetch<Series>(`/api/series/${series_id}`, { method: "GET" });
}

export async function patchSeries(series_id: string, patch: SeriesPatch): Promise<Series> {
  return apiFetch<Series>(`/api/series/${series_id}`, {
    method: "PATCH",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(patch ?? {}),
  });
}
