"use client";

import { useEffect, useMemo, useState } from "react";
import { Series, createSeries, listSeries } from "../../lib/api/series";

export function SeriesList() {
  const [projectId, setProjectId] = useState<string>("p_demo");
  const [items, setItems] = useState<Series[]>([]);
  const [total, setTotal] = useState<number>(0);
  const [loading, setLoading] = useState<boolean>(false);
  const [err, setErr] = useState<string | null>(null);

  const [name, setName] = useState<string>("");
  const [styleText, setStyleText] = useState<string>("");
  const [continuityText, setContinuityText] = useState<string>("");

  const canCreate = useMemo(() => {
    return projectId.trim().length > 0 && name.trim().length > 0;
  }, [projectId, name]);

  async function refresh() {
    setLoading(true);
    setErr(null);
    try {
      const r = await listSeries({ project_id: projectId.trim(), limit: 50, offset: 0 });
      setItems(r.items || []);
      setTotal(r.total || 0);
    } catch (e: any) {
      setErr(e?.message || "failed to load series");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    refresh();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  async function onCreate() {
    if (!canCreate) return;
    setLoading(true);
    setErr(null);
    try {
      await createSeries({
        project_id: projectId.trim(),
        name: name.trim(),
        style_text: styleText.trim() || undefined,
        continuity_text: continuityText.trim() || undefined,
      });
      setName("");
      setStyleText("");
      setContinuityText("");
      await refresh();
    } catch (e: any) {
      setErr(e?.message || "create failed");
    } finally {
      setLoading(false);
    }
  }

  return (
    <div style={{ display: "grid", gap: 16 }}>
      <div style={{ display: "grid", gap: 8, padding: 12, border: "1px solid #ddd", borderRadius: 12 }}>
        <div style={{ display: "flex", gap: 8, alignItems: "center" }}>
          <label style={{ width: 120, color: "#555" }}>project_id *</label>
          <input value={projectId} onChange={(e) => setProjectId(e.target.value)} style={{ flex: 1, padding: 8 }} />
          <button onClick={refresh} disabled={loading || projectId.trim().length === 0} style={{ padding: "8px 12px" }}>
            Refresh
          </button>
        </div>

        <div style={{ display: "flex", gap: 8, alignItems: "center" }}>
          <label style={{ width: 120, color: "#555" }}>name *</label>
          <input value={name} onChange={(e) => setName(e.target.value)} style={{ flex: 1, padding: 8 }} />
          <button onClick={onCreate} disabled={loading || !canCreate} style={{ padding: "8px 12px" }}>
            Create
          </button>
        </div>

        <div style={{ display: "flex", gap: 8, alignItems: "center" }}>
          <label style={{ width: 120, color: "#555" }}>style_text</label>
          <input value={styleText} onChange={(e) => setStyleText(e.target.value)} style={{ flex: 1, padding: 8 }} />
        </div>

        <div style={{ display: "flex", gap: 8, alignItems: "center" }}>
          <label style={{ width: 120, color: "#555" }}>continuity_text</label>
          <input value={continuityText} onChange={(e) => setContinuityText(e.target.value)} style={{ flex: 1, padding: 8 }} />
        </div>

        {err ? <div style={{ color: "crimson" }}>Error: {err}</div> : null}
      </div>

      <div style={{ padding: 12, border: "1px solid #ddd", borderRadius: 12 }}>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline" }}>
          <h2 style={{ margin: 0 }}>Series ({total})</h2>
          {loading ? <span style={{ color: "#666" }}>Loading...</span> : null}
        </div>

        <div style={{ marginTop: 12, display: "grid", gap: 10 }}>
          {items.map((s) => (
            <a
              key={s.id}
              href={`/series/${s.id}`}
              style={{
                display: "block",
                padding: 12,
                border: "1px solid #eee",
                borderRadius: 12,
                textDecoration: "none",
                color: "#111",
              }}
            >
              <div style={{ fontWeight: 700 }}>{s.name}</div>
              <div style={{ color: "#666", fontSize: 12 }}>
                id={s.id} • project_id={s.project_id} • archived_at={s.archived_at ?? "null"}
              </div>
            </a>
          ))}
          {items.length === 0 ? <div style={{ color: "#666" }}>No series found. Create one above.</div> : null}
        </div>
      </div>
    </div>
  );
}
