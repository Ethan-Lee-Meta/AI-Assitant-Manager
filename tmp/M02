        <label style={{ fontWeight: 600 }}>Style / Visual Continuity (text)</label>
        <textarea value={styleText} onChange={(e) => setStyleText(e.target.value)} style={{ padding: 8, width: "100%", minHeight: 120 }} />
      </div>

      <div style={{ display: "grid", gap: 6 }}>
        <label style={{ fontWeight: 600 }}>Plot Mainline / Continuity Notes (text)</label>
        <textarea value={contText} onChange={(e) => setContText(e.target.value)} style={{ padding: 8, width: "100%", minHeight: 140 }} />
      </div>

      <div style={{ display: "grid", gap: 8, borderTop: "1px solid #eee", paddingTop: 12 }}>
        <div style={{ fontWeight: 700 }}>Associations (Prompts / Roles)</div>
        <div style={{ color: "#666" }}>
