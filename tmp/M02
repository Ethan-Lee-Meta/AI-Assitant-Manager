"use client";

import { useEffect, useMemo, useState } from "react";
import { Series, getSeries, patchSeries } from "../../lib/api/series";

export function SeriesWorkspace(props: { seriesId: string }) {
  const seriesId = props.seriesId;

  const [item, setItem] = useState<Series | null>(null);
  const [loading, setLoading] = useState<boolean>(true);
  const [err, setErr] = useState<string | null>(null);

  const [name, setName] = useState<string>("");
  const [styleText, setStyleText] = useState<string>("");
  const [contText, setContText] = useState<string>("");

  useEffect(() => {
    let mounted = true;
    (async () => {
      setLoading(true); setErr(null);
      try {
        const s = await getSeries(seriesId);
        if (!mounted) return;
        setItem(s);
        setName(s.name || "");
        setStyleText(s.style_text || "");
        setContText(s.continuity_text || "");
      } catch (e: any) {
        if (!mounted) return;
        setErr(e?.message || "failed to load series");
      } finally {
        if (mounted) setLoading(false);
      }
    })();
    return () => { mounted = false; };
  }, [seriesId]);

  async function onSave() {
    if (!item) return;
    setErr(null);
    try {
      const s = await patchSeries(seriesId, {
        name: name.trim() || item.name,
        style_text: styleText ?? "",
        continuity_text: contText ?? "",
      });
      setItem(s);
    } catch (e: any) {
      setErr(e?.message || "save failed");
    }
  }

  if (loading) return <div>Loading...</div>;
  if (err) return <div style={{ color: "crimson" }}>{err}</div>;
  if (!item) return <div>Not found</div>;

  return (
    <div style={{ display: "grid", gap: 14 }}>
      <div style={{ display: "grid", gap: 6 }}>
        <div style={{ fontSize: 14, color: "#666" }}>Series ID: {item.id}</div>
