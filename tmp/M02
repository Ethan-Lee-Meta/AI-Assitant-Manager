import { apiFetch } from "./client";

export type Series = {
  id: string;
  project_id: string;
  name: string;
  style_text: string;
  continuity_text: string;
  created_at: string;
  updated_at: string;
  archived_at?: string | null;
};

export type SeriesListResponse = {
  items: Series[];
  total: number;
  limit: number;
  offset: number;
};

export async function listSeries(params: {
  project_id: string;
  q?: string;
  archived?: boolean;
  limit?: number;
  offset?: number;
}): Promise<SeriesListResponse> {
  const qs = new URLSearchParams();
  qs.set("project_id", params.project_id);
  if (params.q) qs.set("q", params.q);
  if (typeof params.archived === "boolean") qs.set("archived", String(params.archived));
  if (typeof params.limit === "number") qs.set("limit", String(params.limit));
  if (typeof params.offset === "number") qs.set("offset", String(params.offset));

  return apiFetch<SeriesListResponse>(`/api/series?${qs.toString()}`, { method: "GET" });
}

export async function createSeries(body: {
  project_id: string;
  name: string;
  style_text?: string;
  continuity_text?: string;
}): Promise<Series> {
  return apiFetch<Series>(`/api/series`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
}

export async function getSeries(series_id: string): Promise<Series> {
  return apiFetch<Series>(`/api/series/${series_id}`, { method: "GET" });
}

export async function patchSeries(series_id: string, patch: Partial<Pick<Series, "name" | "style_text" | "continuity_text" | "archived_at">>): Promise<Series> {
  return apiFetch<Series>(`/api/series/${series_id}`, {
    method: "PATCH",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(patch ?? {}),
  });
}
