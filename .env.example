# =========================================
# Docker Compose project name (optional)
# Helps avoid collisions across different repos.
# =========================================
COMPOSE_PROJECT_NAME=ai_assistant_manager

# =========================================
# Backend (apps/api) - FastAPI platform kernel
# =========================================
# Service name shown in /health response
SERVICE_NAME=ai-assistant-manager

# Environment mode: dev / prod
ENV=dev

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated).
# Example for multi-origins:
#   http://localhost:2000,http://127.0.0.1:2000,http://10.10.10.6:2000
CORS_ALLOW_ORIGINS=http://localhost:2000

# =========================================
# Frontend (apps/web) - Next.js
# =========================================
# Backend base URL used by browser client code
NEXT_PUBLIC_API_BASE_URL=http://localhost:7000
